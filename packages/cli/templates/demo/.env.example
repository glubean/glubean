# Glubean demo project — non-secret vars. Copy to .env (gitignored).
# Loaded into ctx.vars and {{VAR}} template substitution.

# URL of the mock backend (glubean-demo-backend). Replace with your
# deployed Cloudflare Workers URL. The stable/flaky tests + the stable
# contract all point at this.
MOCK_BACKEND_URL=https://demo-backend.example.com
