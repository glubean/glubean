# Glubean demo project — secrets. Copy to .env.secrets (gitignored).
# Loaded into ctx.secrets and auto-redacted in traces.

# Cloud upload token — only for the opt-in upload flow:
#   glubean run --profile full --upload --project <your-project>
# `npm test` / `npm run test:full` run fully local and need none of this.
GLUBEAN_TOKEN=

# Optional — only if your glubean-demo-backend enforces the caller-key
# rate tier. Set this AND uncomment the headers line in config/api.ts.
# DEMO_BACKEND_CALLER_KEY=
