# Glubean demo project — secrets. Copy to .env.secrets (gitignored).
# Loaded into ctx.secrets and auto-redacted in traces.

# Caller key — sent as X-Demo-Caller-Key so the mock backend's rate
# limiter treats this demo as a verified caller (60 req/min vs 10
# req/min anonymous). Must match the backend's DEMO_CALLER_KEY. Leave
# empty if your backend has no caller key configured.
DEMO_BACKEND_CALLER_KEY=

# Cloud upload token (only needed for `npm run test:public-demo`).
GLUBEAN_TOKEN=
