{
  "name": "@glubean/browser",
  "version": "0.13.0",
  "license": "Apache-2.0",
  "engines": { "node": ">=22.19.0" },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./chrome-extension": {
      "types": "./dist/chrome-extension/index.d.ts",
      "import": "./dist/chrome-extension/index.js",
      "default": "./dist/chrome-extension/index.js"
    }
  },
  "files": [
    "NOTICE",
    "dist",
    "guides",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "pretest": "test -n \"$CI\" || pnpm --filter \"@glubean/browser...\" build",
    "pretest:chrome-extension:smoke": "test -n \"$CI\" || pnpm --filter \"@glubean/browser...\" build",
    "pretest:types": "test -n \"$CI\" || pnpm --filter \"@glubean/browser...\" build",
    "test": "vitest run && tsc --noEmit -p tsconfig.test.json",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:chrome-extension:smoke": "vitest run src/chrome-extension/smoke.test.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@glubean/sdk": "workspace:*",
    "puppeteer-core": "^24.41.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "puppeteer-core": ">=24.41.0 <26"
  },
  "peerDependenciesMeta": {
    "puppeteer-core": {
      "optional": false
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glubean/glubean.git",
    "directory": "packages/browser"
  }
}
